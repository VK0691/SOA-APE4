# Plantilla de configuracion local - ventas-api (FastAPI)
# Copie este archivo a .env y reemplace los valores de ejemplo por sus credenciales locales.

# Conexion a MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=venta_vehiculos
DB_USER=root
DB_PASSWORD=

# URL del servicio Java de vehiculos (o NGINX :8090)
JAVA_URL=http://127.0.0.1:8081
VENTAS_SERVICE_KEY=REEMPLAZAR_CLAVE_SERVICIO_MINIMO_32_CARACTERES

# URL del servicio de notificaciones
NOTIFICACIONES_URL=http://127.0.0.1:8083
NOTIFICACIONES_KEY=REEMPLAZAR_CLAVE_NOTIFICACION_MINIMO_32_CARACTERES

# Mensajeria asincrona RabbitMQ (APE 4 - Actividad 8)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE_VENTAS=notificaciones.ventas
